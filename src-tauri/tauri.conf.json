{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokenDaily",
  "version": "0.1.28",
  "identifier": "app.tokendaily.local",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TokenDaily",
        "width": 760,
        "height": 620,
        "minWidth": 500,
        "minHeight": 420,
        "resizable": true,
        "center": true
      },
      {
        "label": "floating",
        "title": "TokenDaily 悬浮窗",
        "url": "index.html?view=floating",
        "width": 56,
        "height": 56,
        "minWidth": 28,
        "minHeight": 56,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE",
      "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    }
  }
}
