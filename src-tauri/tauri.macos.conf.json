{
  "build": {
    "features": [
      "macos-transparent"
    ]
  },
  "bundle": {
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/128x128.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDQzEzQjVFNUZCMUI0MDgKUldRSXRMRmZYanZCUEdOTTMyZkY3Tnd0VVN0WlE4RkpNUzdveEluM3lHSjh2Z2h5UW5LTVdWZDQK",
      "endpoints": [
        "https://tokendaily.net/updates/darwin-{{arch}}.json"
      ],
      "requireSignedVersion": true
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TokenDaily",
        "width": 760,
        "height": 620,
        "minWidth": 500,
        "minHeight": 420,
        "resizable": true,
        "center": true
      },
      {
        "label": "floating",
        "title": "TokenDaily 悬浮窗",
        "url": "index.html?view=floating",
        "width": 56,
        "height": 56,
        "minWidth": 28,
        "minHeight": 56,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "center": false,
        "acceptFirstMouse": true
      }
    ]
  }
}
